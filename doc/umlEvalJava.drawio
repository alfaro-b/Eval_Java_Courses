        <mxCell id="tTQua0BE7EE4VekKWQgv-11" parent="tTQua0BE7EE4VekKWQgv-10" style="connectable=0;recursiveResize=0;strokeColor=inherit;fillColor=none;align=left;whiteSpace=wrap;html=1;fontSize=16;spacingLeft=20;" value="Règles fonctionelles" vertex="1">
          <mxGeometry height="275" width="280" as="geometry">
            <mxRectangle height="275" width="280" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="tTQua0BE7EE4VekKWQgv-12" parent="tTQua0BE7EE4VekKWQgv-10" style="connectable=0;recursiveResize=0;strokeColor=inherit;fillColor=none;align=left;whiteSpace=wrap;html=1;spacingLeft=10;fontSize=16;" value="&lt;div style=&quot;line-height: 150%;&quot;&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;une formation peut être disponible en présentiel et/ou distanciel,&amp;nbsp;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;plusieurs exemplaires d’une formation peuvent être commandés,&amp;nbsp;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;le panier n’est pas persistant,&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;une commande doit contenir au moins une formation,&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;une commande est associée à un seul client,&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;un acheteur peut passer plusieurs commandes,&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;un même acheteur peut passer des commandes pour différents clients,&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;le prix enregistré dans la commande correspond au prix au moment de la validation,&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;la quantité d’une formation dans une commande doit être strictement positive.&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="275" width="793" x="280" as="geometry">
            <mxRectangle height="275" width="793" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
